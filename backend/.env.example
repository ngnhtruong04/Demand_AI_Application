APP_NAME=Rohlik Sales API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.189.189:3000"]

# Shared RDS connection settings
RDS_ENDPOINT=your-db.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=rohlik_sales
RDS_SSL_MODE=verify-full
RDS_SSL_ROOT_CERT=certs/global-bundle.pem

# Master credentials: only Alembic and ingestion/administration scripts may use these
RDS_MASTER_USERNAME=tttv_admin
RDS_MASTER_PASSWORD=replace-with-master-password

# Runtime credentials: FastAPI must only use these
RDS_API_USERNAME=tttv_demandforecast_api
RDS_API_PASSWORD=replace-with-api-user-password

# Raw input directory
RAW_DATA_DIR=data/raw
RAW_PROFILE_REPORT=reports/raw_profile.json

# Small pool for the local FastAPI application
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300

# Core source mapping is stored in config/core_sources.json.
# Dedicated migration/ETL credentials can replace master use when provisioned by the DBA.
